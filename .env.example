# Copie este arquivo pra ".env.local" (NÃO commitar o .env.local — já está no .gitignore)
# e preencha com os valores reais. Na Vercel, as mesmas chaves vão em
# Project Settings > Environment Variables.

# Supabase (mesmo projeto do agendador-stories e do Chatbot Direct — só as tabelas são novas,
# prefixo directgov_)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App do Meta for Developers (novo, separado dos Apps do agendador e do Chatbot Direct)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Opcional — só precisa preencher se o domínio fixo do projeto mudar algum dia.
# Sem essa variável, o código usa "https://directgov.vercel.app" por padrão.
NEXT_PUBLIC_APP_URL=

# Chave de API do Gemini (a mesma que você já paga hoje)
GEMINI_API_KEY=

# Opcional — nome do modelo do Gemini. Sem essa variável, o código usa "gemini-flash-lite-latest"
# por padrão. Prefira um apelido que o Google mantém atualizado sozinho (como esse) em vez de uma
# versão fixa (tipo "gemini-2.0-flash") — o Google já aposentou modelo fixo no meio da produção
# do Chatbot Direct, e trocar aqui não exige nenhuma mudança de código.
GEMINI_MODEL=
