# Copie este arquivo pra ".env.local" (NÃO commitar o .env.local — já está no .gitignore)
# e preencha com os valores reais. Na Vercel, as mesmas chaves vão em
# Project Settings > Environment Variables.

# Supabase (mesmo projeto do agendador-stories — só as tabelas são novas, prefixo chatbot_)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App do Meta for Developers (novo, separado do App do agendador)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Chave de API do Gemini (a mesma que você já paga hoje)
GEMINI_API_KEY=
